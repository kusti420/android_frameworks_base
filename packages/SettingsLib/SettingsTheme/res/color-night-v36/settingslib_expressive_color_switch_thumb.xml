<!-- IchthysOS Shoal (dark): ink thumb (#07090b) on the accent track when on, muted #8b938f
     thumb on the #161c20 track when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.38" android:color="#FF8B938F"
        android:state_enabled="false" android:state_checked="false"/>
    <item android:alpha="0.6" android:color="#FF07090B"
        android:state_enabled="false" android:state_checked="true"/>
    <item android:color="#FF07090B" android:state_checked="true"/>
    <item android:color="#FF8B938F"/>
</selector>
