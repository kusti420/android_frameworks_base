<!-- IchthysOS Shoal (dark): 44dp back button, a 1dp #20282d hairline circle on the ink ground
     with an off-white (#f2f4f1) stroke chevron. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size android:width="44dp" android:height="44dp" />
            <solid android:color="#FF0C1013" />
            <stroke android:width="1dp" android:color="#FF20282D" />
        </shape>
    </item>

    <item
        android:width="20dp"
        android:height="20dp"
        android:gravity="center">
        <vector
            android:width="20dp"
            android:height="20dp"
            android:viewportWidth="24"
            android:viewportHeight="24"
            android:autoMirrored="true">
            <path
                android:pathData="M15,5l-7,7l7,7"
                android:strokeColor="#FFF2F4F1"
                android:strokeWidth="2"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
        </vector>
    </item>
    <item android:drawable="?android:attr/actionBarItemBackground" />
</layer-list>
