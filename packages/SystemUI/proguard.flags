-include proguard_common.flags

-keep class com.android.systemui.SystemUIInitializerImpl {
    *;
}

-keep,allowoptimization,allowaccessmodification class com.android.systemui.dagger.DaggerReferenceGlobalRootComponent** { !synthetic *; }

# Legacy (Android 7.1.1-style) recents is selected reflectively via
# R.string.config_recentsComponent, so keep it and its activity from being stripped by R8.
-keep class com.android.systemui.recents.LegacyRecentsImpl { *; }
-keep class com.android.systemui.recents.LegacyRecents* { *; }

# IchthysOS: the drawn lock screen clock faces are inflated out of com.android.settings' layouts
# (KeyguardCustomClockView), which R8 doesn't see: keep every face and its inflation constructors.
-keep class com.android.settingslib.ichthys.clock.** {
    public <init>(android.content.Context);
    public <init>(android.content.Context, android.util.AttributeSet);
    *;
}
