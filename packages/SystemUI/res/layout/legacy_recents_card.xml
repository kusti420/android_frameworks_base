<!-- A 7.1.1-style task card: a coloured header (icon, title, dismiss X) above the app snapshot. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    android:orientation="vertical"
    android:background="@drawable/legacy_recents_card_bg"
    android:clipToOutline="true"
    android:elevation="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/legacy_recents_card_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/legacy_recents_card_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="16dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/legacy_recents_card_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/legacy_recents_card_dismiss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="✕"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- The app's actual last-frame snapshot, like Android 7.1.1 recents. -->
    <ImageView
        android:id="@+id/legacy_recents_card_thumbnail"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:scaleType="matrix"
        android:background="#FFFFFFFF"
        android:contentDescription="@null" />

</LinearLayout>
