<!--
  Samsung Grace UX (Android 7.0) recents card, as TaskViewHeader lays it out with Samsung's
  EnableLowerAppbarHeight / EnableMoreRound (values for a sw360dp phone):
    header          44dp (recents_lower_task_view_header_height)
    icon cell       41dp square, 10dp padding (a 21dp icon), 4dp from the card's start edge
    title           17sp condensed, #fafafa on dark task colours, starting right after the icon cell
    dismiss cell    44dp square, 11.5dp padding, 5dp from the card's end edge
    corners         6dp (recents_task_view_more_rounded_corners_radius)
  Values re-implemented from the resource numbers; no Samsung asset is used.

  Size and horizontal placement are deliberately NOT declared here: GraceUxStyle's layout manager
  measures every card to one derived rect and scales it about its centre for depth.

  There is no dim overlay: Grace UX does not dim cards, it fades out the ones far back.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/oneui_recents_graceux_card_bg"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@id/oneui_recents_card_header"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="5dp">
            <ImageView
                android:id="@id/oneui_recents_card_icon"
                android:layout_width="41dp"
                android:layout_height="41dp"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
            <TextView
                android:id="@id/oneui_recents_card_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="sans-serif-condensed"
                android:textColor="#FFFAFAFA"
                android:textSize="17sp" />
            <TextView
                android:id="@id/oneui_recents_card_dismiss"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFAFAFA"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
        <!-- MATRIX: the snapshot scaled to the card width and pinned to the top, as TaskViewThumbnail
             did. Safe because the depth taper is a view transform, so the measured width never
             changes as a card moves through the stack. -->
        <ImageView
            android:id="@id/oneui_recents_card_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="matrix"
            android:background="#FFFFFFFF"
            android:contentDescription="@null" />

    </LinearLayout>

</FrameLayout>
