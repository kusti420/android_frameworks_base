<!--
  List recents row, modelled on the One UI "Vertical list" task changer.

  The defining trait of that layout is that the app's identity is NOT on the card: the icon and the
  app name sit in their own column to the LEFT of the card, on the wallpaper, top-aligned with it.
  The card itself is bare — a rounded snapshot and nothing else. So this file has no header bar, no
  title strip and no dismiss ✕ (One UI has none either; a task is dismissed by swiping the row).

  Because there is no view with the @id/oneui_recents_card_header ID, RecentsCardBinder's whole
  "tint the header and re-colour the text on it" block is skipped — the title keeps the white
  declared here, which is what it needs over a blurred wallpaper.

  The whole row is one item view: the host sets its click listener, so tapping the icon, the name or
  the card all launch the task. Press feedback is a ripple on the card only (pressed state and the
  touch hotspot are dispatched down from the row by ViewGroup), because the card is the piece that
  reads as the button.

  Card size here is measured geometry, not guesswork: on the reference device (1080x2400 @ 420dpi)
  the card is 585x447px = 223x170dp — 54.2% of the screen width at a 1.31:1 aspect — sitting 19dp
  off the right edge, with the icon column starting 19dp off the left edge. The dp values below are
  that portrait phone case; ListStyle re-derives both from the live RecyclerView size, so a rotation
  (which the host absorbs without being recreated) does not leave one card filling the window.

  The IDs come from res/values/oneui_recents_ids.xml (hence @id, not @+id) because
  RecentsCardBinder populates them for every style. Vertical gaps between rows are added by
  ListStyle's item decoration rather than a layout margin, so the spacing stays uniform as rows
  come and go.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:paddingStart="19dp"
    android:paddingEnd="19dp"
    android:clickable="true"
    android:focusable="true">

    <!--
      Icon + app name, on the wallpaper. Weighted, so it simply takes whatever width the card
      leaves; top-aligned, so the icon lines up with the top edge of the card the way it does on
      One UI. No end padding: the label is allowed to run right up to the card and ellipsize there —
      the card's 26dp corner is what gives it breathing room at that height.
    -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@id/oneui_recents_card_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <TextView
            android:id="@id/oneui_recents_card_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

    <!--
      The card. This ImageView *is* the card — there is no wrapper, because there is nothing else on
      it: the rounded shape is its background (which also supplies the outline that clipToOutline
      rounds the snapshot against), and that fill is what shows through for a task with no snapshot.

      scaleType="matrix" is the contract RecentsCardBinder reads as "scale the snapshot to the card
      width and pin it to the top", which is how One UI crops these — you see the app's own header
      and the top of its content, not a slice out of its middle. ListStyle re-derives that matrix
      whenever the card is resized, because a rotation resizes cards without rebinding them.

      No elevation: measured against the real thing there is no shadow under these cards at all,
      just a hard edge onto the blurred wallpaper.
    -->
    <ImageView
        android:id="@id/oneui_recents_card_thumbnail"
        android:layout_width="223dp"
        android:layout_height="170dp"
        android:layout_gravity="top"
        android:scaleType="matrix"
        android:background="@drawable/oneui_recents_list_card_bg"
        android:foreground="@drawable/oneui_recents_list_press"
        android:clipToOutline="true"
        android:contentDescription="@null" />

</LinearLayout>
