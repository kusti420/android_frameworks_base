<!-- IchthysOS advanced restart: container for the "Restart…" submenu. Rows of tiles are added
     by GlobalActionsPowerDialog#createRestart. No dividers (unlike global_actions_power_dialog):
     the main power menu separates its items with whitespace only, and the rounded surface comes
     from the window background (global_actions_lite_background), the same drawable the main
     power menu uses. Padding here plus the per-item margin adds up to the main menu's
     global_actions_lite_padding on the outside and between tiles. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="@dimen/global_actions_restart_item_margin"
/>
