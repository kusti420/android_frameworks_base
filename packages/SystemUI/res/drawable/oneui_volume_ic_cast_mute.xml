<!-- Custom Options: One UI remote / cast output, muted - a screen with cast arcs and a mute slash.
     Original vector recreation in the One UI volume-icon family (no Samsung asset):
     24dp / 24 viewport, solid fills for masses + 1.5-1.9 round-cap strokes for arcs and rules,
     matching oneui_volume_ic_media_note_waves. Always rendered with a tint (Compose tint or
     ImageView colour filter), so the literal colours below are placeholders the tint overrides. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- screen (bottom-left left open for the arcs) -->
    <path
        android:strokeColor="#FF1A1A1C"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M2.6,7.0 V6.4 a1.8,1.8 0 0,1 1.8,-1.8 h15.2 a1.8,1.8 0 0,1 1.8,1.8 v11.2 a1.8,1.8 0 0,1 -1.8,1.8 h-7.0" />
    <!-- outer cast arc -->
    <path
        android:strokeColor="#FF1A1A1C"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M2.6,11.0 a8.4,8.4 0 0,1 8.4,8.4" />
    <!-- inner cast arc -->
    <path
        android:strokeColor="#FF1A1A1C"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M2.6,14.8 a4.6,4.6 0 0,1 4.6,4.6" />
    <!-- source dot -->
    <path
        android:fillColor="#FF1A1A1C"
        android:pathData="M3.9,18.1 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 z" />
    <!-- mute slash -->
    <path
        android:strokeColor="#FF1A1A1C"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M4.8,4.4 L19.2,18.8" />
</vector>
