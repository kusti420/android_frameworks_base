<!--
    IchthysOS Night Light glyph, filled (Night Light tinting the screen now): a setting sun - a
    round disc cut by a tapered, rising curved sweep, leaving the sun above and a sliver of it
    below. Single colour; the caller tints it. Outline counterpart: ic_qs_ichthys_nightlight_off.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- The sun above the sweep. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3.2,13.8A9,9 0,0 1,20.6 9.4Q11,16.5 3.2,13.8Z" />
    <!-- The sliver below the sweep. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M20.86,10.44A9,9 0,0 1,3.44 14.78Q12.5,20.5 20.86,10.44Z" />
</vector>
