<!-- IchthysOS: Backstage tile glyph: an app window still playing, with another one tucked
     behind it (apps that keep running out of sight). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?android:attr/colorControlNormal">
    <!-- The window behind, peeking out top-right -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M8,4.2 H17.6 A2.2,2.2 0 0,1 19.8,6.4 V16" />
    <!-- The window in front -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:pathData="M6.2,7.8 H14 A2,2 0 0,1 16,9.8 V17.6 A2,2 0 0,1 14,19.6 H6.2 A2,2 0 0,1 4.2,17.6 V9.8 A2,2 0 0,1 6.2,7.8 Z" />
    <!-- Still playing -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M8.6,10.9 L12.9,13.7 L8.6,16.5 Z" />
</vector>
