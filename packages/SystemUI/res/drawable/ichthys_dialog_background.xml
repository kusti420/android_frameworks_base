<!-- Window background of SystemUI dialogs: the framework's dialog_background_material (same
     inset, fill and radius) plus the Shoal hairline, so the dialog has an edge on the ink ground.
     Keep it an <inset> around a single <shape>: SystemUIDialog sizes the window from the optical
     insets and DialogTransitionAnimator reads the fill and radius from the GradientDrawable. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="16dp">
    <shape android:shape="rectangle">
        <corners android:radius="?android:attr/dialogCornerRadius" />
        <solid android:color="?android:attr/colorBackground" />
        <stroke
            android:width="@*android:dimen/ichthys_hairline_width"
            android:color="@*android:color/ichthys_hairline" />
    </shape>
</inset>
