<!--
  Card body for the Grace UX stack.

  6dp corners: recents_task_view_more_rounded_corners_radius, Samsung's EnableMoreRound value
  (the photographed card measured ~5dp, i.e. the same radius after the depth taper). Rounder than
  AOSP 7.1.1's 2dp (see oneui_recents_grace_card_bg), one of the tells that separates Samsung's
  stack from the AOSP one it was built on.

  Doubles as the outline source: the card sets clipToOutline, so this radius is what rounds the
  binder's flat header tint at the top, rounds the snapshot at the bottom, and shapes the elevation
  shadow that GraceUxStyle ramps from 3dp x 0.75 at the back of the stack to 24dp x 0.75 at the front.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners android:radius="6dp" />
</shape>
