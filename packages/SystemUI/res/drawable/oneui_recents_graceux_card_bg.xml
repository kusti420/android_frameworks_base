<!--
  Card body for the Grace UX stack.

  5dp corners, measured off an SM-A310F running A310FXXS5CTJ2 (720x1280 @ 2.0 px/dp): the front
  card's left edge runs from x=63 at its first row (y=305) to its full x=55 at y=314, and the
  bottom corner mirrors that over y=1159..1168 — a 10px arc either end, so r = 10px = 5dp.
  That is noticeably rounder than AOSP 7.1.1's 2dp (see oneui_recents_grace_card_bg) and is one of
  the small tells that separates Samsung's stack from the AOSP one it was built on.

  Doubles as the outline source: the card sets clipToOutline, so this radius is what rounds the
  binder's flat header tint at the top, rounds the snapshot at the bottom, and shapes the elevation
  shadow that GraceUxStyle ramps from 1dp at the back of the stack to 14dp at the front.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners android:radius="5dp" />
</shape>
