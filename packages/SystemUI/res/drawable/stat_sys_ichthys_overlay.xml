<!-- IchthysOS: status bar indicator while a non-system app draws over other apps
     (SYSTEM_ALERT_WINDOW): a window (solid) lying on top of another (hairline). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- The window underneath: only its uncovered corner shows -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M4.4,15.6 V5.4 A1,1 0 0,1 5.4,4.4 H15.6" />
    <!-- The overlay on top -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M10.3,8.5 H18.7 A1.8,1.8 0 0,1 20.5,10.3 V18.7 A1.8,1.8 0 0,1 18.7,20.5 H10.3 A1.8,1.8 0 0,1 8.5,18.7 V10.3 A1.8,1.8 0 0,1 10.3,8.5 Z" />
</vector>
