<!-- Custom Options: One UI system-sounds stream - a speaker with two sound-wave arcs (same wave language as the media note).
     Original vector recreation in the One UI volume-icon family (no Samsung asset):
     24dp / 24 viewport, solid fills for masses + 1.5-1.9 round-cap strokes for arcs and rules,
     matching oneui_volume_ic_media_note_waves. Always rendered with a tint (Compose tint or
     ImageView colour filter), so the literal colours below are placeholders the tint overrides. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- speaker cone -->
    <path
        android:fillColor="#FF1A1A1C"
        android:pathData="M11.4,4.6 L6.8,8.6 H3.6 a1.4,1.4 0 0,0 -1.4,1.4 v4.0 a1.4,1.4 0 0,0 1.4,1.4 h3.2 l4.6,4.0 a1.0,1.0 0 0,0 1.7,-0.8 V5.4 a1.0,1.0 0 0,0 -1.7,-0.8 z" />
    <!-- inner sound wave -->
    <path
        android:strokeColor="#FF1A1A1C"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M16.0,9.6 a3.4,3.4 0 0,1 0,4.8" />
    <!-- outer sound wave -->
    <path
        android:strokeColor="#FF1A1A1C"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M18.4,7.4 a5.8,5.8 0 0,1 0,9.2" />
</vector>
