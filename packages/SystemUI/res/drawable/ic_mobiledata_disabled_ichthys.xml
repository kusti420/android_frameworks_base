     Original artwork: a hollow cellular-signal triangle overlaid with a
     diagonal slash to indicate that mobile data is disabled. The whole glyph
     is a single even-odd path so that where the slash crosses the triangle
     outline the coverage cancels, producing clean "cut" gaps under a single
     status bar tint.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        android:width="24dp"
        android:height="24dp"
        android:viewportWidth="24.0"
        android:viewportHeight="24.0">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M3,20.5 L20.5,20.5 L20.5,3 Z
                          M6.5,18.5 L17,18.5 L17,7.5 Z
                          M3,5.5 L5.5,3 L21.5,19 L19,21.5 Z" />
</vector>
