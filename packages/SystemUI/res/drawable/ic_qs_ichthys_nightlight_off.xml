<!-- IchthysOS: Night Light glyph after the f.lux logo: a ringed disc split by a wave, sky empty (not tinted). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?android:attr/colorControlNormal">
    <!-- Rim -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:pathData="M12,1.8 a10.2,10.2 0 1,1 0,20.4 a10.2,10.2 0 1,1 0,-20.4 Z" />
    <!-- The "sea": swells from the left, curves down to the right (f.lux wave) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M3.92,10.6 C7.5,9.2 11.5,9.6 14.2,12.2 C15.9,13.8 17.6,15.0 19.55,15.2 A8.2,8.2 0 0,1 3.92,10.6 Z" />
</vector>
