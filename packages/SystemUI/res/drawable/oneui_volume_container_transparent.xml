<!-- Custom Options: One UI has NO wrapping dialog container - the ringer pill, the slider capsule
     and the settings pill float as separate rounded elements. This fully-transparent shape replaces
     the stock AOSP container / ringer-drawer surface so nothing is drawn around them. It stays a
     <shape> (GradientDrawable) so the ringer binder's corner-radius animation, which casts the
     background to GradientDrawable, keeps working. Original asset. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/volume_dialog_background_square_corner_radius"/>
    <solid android:color="@android:color/transparent"/>
</shape>
