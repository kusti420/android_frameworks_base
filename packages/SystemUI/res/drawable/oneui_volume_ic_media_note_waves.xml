<!-- Custom Options: One UI media stream glyph - an eighth note with two sound-wave arcs to the
     right. Original vector recreation (no Samsung asset). Rendered with a Compose tint, so the
     literal colors below are just placeholders the tint overrides. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- note head -->
    <path
        android:fillColor="#FF1A1A1C"
        android:pathData="M7.8,15.6 m-2.6,0 a2.6,2.3 0 1,0 5.2,0 a2.6,2.3 0 1,0 -5.2,0 z" />
    <!-- stem -->
    <path
        android:fillColor="#FF1A1A1C"
        android:pathData="M9.9,6 h1.4 v9.6 h-1.4 z" />
    <!-- flag -->
    <path
        android:fillColor="#FF1A1A1C"
        android:pathData="M11.3,5.8 c2.3,0.4 3.6,2 3.6,4.1 c0,-1 -1.3,-2.5 -3.6,-2.9 z" />
    <!-- inner sound wave -->
    <path
        android:strokeColor="#FF1A1A1C"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M16,9.8 a3.3,3.3 0 0,1 0,4.6" />
    <!-- outer sound wave -->
    <path
        android:strokeColor="#FF1A1A1C"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M18.2,8 a5.5,5.5 0 0,1 0,8.2" />
</vector>
