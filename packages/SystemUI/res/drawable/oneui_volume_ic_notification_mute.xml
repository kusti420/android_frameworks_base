<!-- Custom Options: One UI notification stream, muted - a rounded chat bubble with a mute slash.
     Visually distinct from the ringtone bell so the two are never confused in the expanded panel.
     24dp / 24 viewport. Always rendered with a tint. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- bubble body -->
    <path
        android:fillColor="#FF1A1A1C"
        android:pathData="M4,4 h16 a2,2 0 0,1 2,2 v9 a2,2 0 0,1 -2,2 h-4.6 l-3.4,3.4 l-3.4,-3.4 H4 a2,2 0 0,1 -2,-2 V6 a2,2 0 0,1 2,-2 z" />
    <!-- dot left -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8,10.5 m-1.2,0 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 z" />
    <!-- dot center -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,10.5 m-1.2,0 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 z" />
    <!-- dot right -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M16,10.5 m-1.2,0 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 z" />
    <!-- mute slash -->
    <path
        android:strokeColor="#FF1A1A1C"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M4.8,4.4 L19.2,18.8" />
</vector>
