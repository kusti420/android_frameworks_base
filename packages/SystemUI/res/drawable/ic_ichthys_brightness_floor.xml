<?xml version="1.0" encoding="utf-8"?>
<!--
    IchthysOS: the auto-brightness minimum-floor marker, as a button glyph.

    Deliberately a miniature of the on-track handle itself (track line, vertical floor bar, curved
    stem, hanging knob) rather than an abstract symbol: the button's whole job is to show/hide that
    marker, so the icon is a picture of what will appear. Untinted for the same reason as the
    adaptive icons - the caller supplies the colour and the dimmed/disabled alpha.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <!-- The slider track. -->
  <path
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="2.0"
      android:strokeLineCap="round"
      android:pathData="M3.5,9.5L20.5,9.5" />
  <!-- The floor bar standing on the track. -->
  <path
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="2.4"
      android:strokeLineCap="round"
      android:pathData="M9,6.2L9,12.8" />
  <!-- The curved stem, bowing right exactly like the real handle. -->
  <path
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="1.6"
      android:strokeLineCap="round"
      android:pathData="M9,13.2C9,14.6 13.5,14.2 13.5,15.6" />
  <!-- The knob. -->
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M11.1,17.7A2.4,2.4 0 1,1 15.9,17.7A2.4,2.4 0 1,1 11.1,17.7Z" />
</vector>
