<!--
     Toggleable RRO used by the crDroidSettings "Custom clock style" picker
     (CustomClockPreview / ClockPickerFragment) via the OverlayManager. Enabling it records that
     the stock lockscreen clock should be hidden while a custom IchthysOS clock face is active.
     The actual hiding of the AOSP blueprint clock is enforced in SystemUI's ClockSection keyed on
     Settings.Secure.LOCK_SCREEN_CUSTOM_CLOCK_STYLE; this package exists so the picker's
     setEnabledExclusiveInCategory call resolves to a real package.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.systemui.clocks.hideclock"
    android:versionCode="1"
    android:versionName="1.0">

    <overlay android:targetPackage="android"
        android:category="android.theme.customization.hideclock"
        android:priority="1"/>

    <application android:label="@string/ichthys_hideclock_label" android:hasCode="false"/>
</manifest>
