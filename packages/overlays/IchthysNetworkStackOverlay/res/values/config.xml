<resources>

    <!-- IchthysOS: connectivity / captive-portal checks go to GrapheneOS' check servers instead
         of connectivitycheck.gstatic.com / www.google.com. Captive-portal mode stays "prompt",
         so hotel and airport Wi-Fi logins still work. (kusti420/ichthysos-tracker#15) -->
    <string name="config_captive_portal_http_url" translatable="false">http://connectivitycheck.grapheneos.network/generate_204</string>
    <string name="config_captive_portal_https_url" translatable="false">https://connectivitycheck.grapheneos.network/generate_204</string>
    <string-array name="config_captive_portal_fallback_urls" translatable="false">
        <item>http://grapheneos.online/gen_204</item>
        <item>https://grapheneos.online/generate_204</item>
    </string-array>

    <!-- IchthysOS: do NOT send a hostname (DHCP option 12). A stable, unique name sent on every
         network links the phone across networks and defeats per-network MAC randomization.
         The preferred-props list below is kept so the name can be turned back on here.
         (kusti420/ichthysos-tracker#16) -->
    <bool name="config_dhcp_client_hostname">false</bool>

    <!-- Take the hostname from a property instead of Settings.Global.DEVICE_NAME, so only the
         LAN sees the joke and Bluetooth / Wi-Fi Direct / Settings > About keep the real device
         name. DhcpClient only accepts ro.product.model, ro.product.name and ro.vendor.* here
         (DhcpClient.Dependencies#isValidCustomHostnameProperty); if the property is missing it
         silently falls back to DEVICE_NAME. -->
    <string-array name="config_dhcp_client_hostname_preferred_props" translatable="false">
        <item>ro.vendor.net.hostname</item>
    </string-array>

</resources>
