# IchthysOS theme preset "Paper": calm deep-teal accent on plain neutral surfaces, tighter corners.
{
  theme = {
    accent = "#2f6f6a";
    # IchthysOS: "neutral" is no Monet style SystemUI applies; it always rendered as tonal spot.
    style = "tonalSpot";
    neutral = "neutral";
    surfaces = 2;
    shape.radius = 12;
    shape.style = "rounded";
  };
}
