# IchthysOS theme preset "Abyss": the first Shoal look. Deep tinted tonal (filled) surfaces,
# teal accent, pill shapes, Outfit titles over IBM Plex Sans.
{
  theme = {
    accent = "#5cc8c2";
    style = "tonalSpot";
    neutral = "tinted";
    surfaces = 3;
    shape.radius = 22;
    shape.style = "pill";
    density = "standard";
    surface = "tonal";
    font.display = "outfit";
    font.mono = "ibm-plex-sans";
    font.text = "ibm-plex-sans";
    iconBadges = true;
  };
}
