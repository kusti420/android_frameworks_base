# IchthysOS theme preset "Koi" (default): ink ground, hairline-outlined surfaces, koi-orange
# accent, Syne titles, JetBrains Mono numerals, Instrument Sans body.
{
  theme = {
    accent = "#ff6b3d";
    style = "tonalSpot";
    neutral = "neutral";
    pitchBlack = false; # true pins the ink ground to #000 (OLED); koi's ink is #07090b
    surface = "hairline";
    surfaces = 4; # ink, card, raised, tile: the full koi ramp
    shape.radius = 22;
    shape.style = "pill";
    font.display = "syne";
    font.mono = "jetbrains-mono";
    font.text = "instrument-sans";
    iconBadges = true;
    iconStyle = "mono";
  };
}
