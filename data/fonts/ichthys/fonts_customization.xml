    <family customizationType="new-named-family" name="nunito-sans">
        <font weight="400" style="normal">NunitoSans-VF.ttf<axis tag="wght" stylevalue="400" /></font>
        <font weight="500" style="normal">NunitoSans-VF.ttf<axis tag="wght" stylevalue="500" /></font>
        <font weight="600" style="normal">NunitoSans-VF.ttf<axis tag="wght" stylevalue="600" /></font>
        <font weight="700" style="normal">NunitoSans-VF.ttf<axis tag="wght" stylevalue="700" /></font>
    </family>
    <family customizationType="new-named-family" name="plus-jakarta-sans">
        <font weight="400" style="normal">PlusJakartaSans-VF.ttf<axis tag="wght" stylevalue="400" /></font>
        <font weight="500" style="normal">PlusJakartaSans-VF.ttf<axis tag="wght" stylevalue="500" /></font>
        <font weight="600" style="normal">PlusJakartaSans-VF.ttf<axis tag="wght" stylevalue="600" /></font>
