        <font weight="400" style="normal">Manrope-VF.ttf<axis tag="wght" stylevalue="400" /></font>
        <font weight="500" style="normal">Manrope-VF.ttf<axis tag="wght" stylevalue="500" /></font>
        <font weight="600" style="normal">Manrope-VF.ttf<axis tag="wght" stylevalue="600" /></font>
        <font weight="700" style="normal">Manrope-VF.ttf<axis tag="wght" stylevalue="700" /></font>
