        <font weight="600" style="normal">JetBrainsMono-VF.ttf<axis tag="wght" stylevalue="600" /></font>
        <font weight="700" style="normal">JetBrainsMono-VF.ttf<axis tag="wght" stylevalue="700" /></font>
    </family>
    <family customizationType="new-named-family" name="outfit">
        <font weight="400" style="normal">Outfit-VF.ttf<axis tag="wght" stylevalue="400" /></font>
        <font weight="500" style="normal">Outfit-VF.ttf<axis tag="wght" stylevalue="500" /></font>
        <font weight="600" style="normal">Outfit-VF.ttf<axis tag="wght" stylevalue="600" /></font>
        <font weight="700" style="normal">Outfit-VF.ttf<axis tag="wght" stylevalue="700" /></font>
    </family>
    <family customizationType="new-named-family" name="ibm-plex-sans">
