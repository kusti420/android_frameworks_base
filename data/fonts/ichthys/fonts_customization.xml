    <family customizationType="new-named-family" name="source-sans-3">
        <font weight="400" style="normal">SourceSans3-VF.ttf<axis tag="wght" stylevalue="400" /></font>
        <font weight="500" style="normal">SourceSans3-VF.ttf<axis tag="wght" stylevalue="500" /></font>
        <font weight="600" style="normal">SourceSans3-VF.ttf<axis tag="wght" stylevalue="600" /></font>
        <font weight="700" style="normal">SourceSans3-VF.ttf<axis tag="wght" stylevalue="700" /></font>
    </family>

    <!-- Lock screen clock display faces (single weight; DepthClockView loads the files by path,
         the families are for android:fontFamily / Typeface.create). -->
    <family customizationType="new-named-family" name="rubik-bubbles">
        <font weight="400" style="normal">RubikBubbles-Regular.ttf</font>
    </family>
    <family customizationType="new-named-family" name="bowlby-one">
        <font weight="400" style="normal">BowlbyOne-Regular.ttf</font>
    </family>
    <family customizationType="new-named-family" name="bungee-inline">
        <font weight="400" style="normal">BungeeInline-Regular.ttf</font>
    </family>

    <!-- Medium faces for config_bodyFontFamilyMedium / config_headlineFontFamilyMedium. -->
    <alias name="instrument-sans-medium" to="instrument-sans" weight="500" />
    <alias name="outfit-medium" to="outfit" weight="500" />
    <alias name="ibm-plex-sans-medium" to="ibm-plex-sans" weight="500" />
    <alias name="atkinson-hyperlegible-next-medium" to="atkinson-hyperlegible-next" weight="500" />
    <alias name="dm-sans-medium" to="dm-sans" weight="500" />
    <alias name="figtree-medium" to="figtree" weight="500" />
    <alias name="inter-medium" to="inter" weight="500" />
    <alias name="lexend-medium" to="lexend" weight="500" />
    <alias name="manrope-medium" to="manrope" weight="500" />
    <alias name="nunito-sans-medium" to="nunito-sans" weight="500" />
