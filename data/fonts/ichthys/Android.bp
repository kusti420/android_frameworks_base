    name: "IchthysBowlbyOne-Regular.ttf",
    src: "BowlbyOne-Regular.ttf",
    filename: "BowlbyOne-Regular.ttf",
    product_specific: true,
}

prebuilt_font {
    name: "IchthysBungeeInline-Regular.ttf",
    src: "BungeeInline-Regular.ttf",
    filename: "BungeeInline-Regular.ttf",
    product_specific: true,
}

prebuilt_etc {
    name: "fonts_customization.xml",
    src: "fonts_customization.xml",
    filename: "fonts_customization.xml",
    product_specific: true,
    required: [
        "IchthysSyne-VF.ttf",
        "IchthysInstrumentSans-VF.ttf",
        "IchthysJetBrainsMono-VF.ttf",
        "IchthysOutfit-VF.ttf",
        "IchthysIBMPlexSans-VF.ttf",
        "IchthysAtkinsonHyperlegibleNext-VF.ttf",
        "IchthysDMSans-VF.ttf",
        "IchthysFigtree-VF.ttf",
        "IchthysInter-VF.ttf",
        "IchthysLexend-VF.ttf",
        "IchthysManrope-VF.ttf",
        "IchthysNunitoSans-VF.ttf",
        "IchthysPlusJakartaSans-VF.ttf",
        "IchthysPublicSans-VF.ttf",
        "IchthysSourceSans3-VF.ttf",
        "IchthysRubikBubbles-Regular.ttf",
        "IchthysBowlbyOne-Regular.ttf",
        "IchthysBungeeInline-Regular.ttf",
    ],
}
