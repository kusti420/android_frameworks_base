    product_specific: true,
}

prebuilt_font {
    name: "IchthysLexend-VF.ttf",
    src: "Lexend-VF.ttf",
    filename: "Lexend-VF.ttf",
    product_specific: true,
}

prebuilt_font {
    name: "IchthysManrope-VF.ttf",
    src: "Manrope-VF.ttf",
    filename: "Manrope-VF.ttf",
    product_specific: true,
}

prebuilt_font {
