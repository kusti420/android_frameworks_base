// IchthysOS: product fonts for the "Shoal" design (tracker#50) and the system font options of
// Theme Studio (theme.font.body overlays in packages/overlays/Font*Overlay). All SIL OFL 1.1.
package {
    default_applicable_licenses: ["frameworks_base_data_fonts_ichthys_license"],
}

license {
    name: "frameworks_base_data_fonts_ichthys_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-OFL"],
    license_text: [
        "OFL-syne.txt",
        "OFL-instrumentsans.txt",
        "OFL-jetbrainsmono.txt",
        "OFL-outfit.txt",
        "OFL-ibmplexsans.txt",
        "OFL-atkinsonhyperlegiblenext.txt",
        "OFL-dmsans.txt",
        "OFL-figtree.txt",
        "OFL-inter.txt",
        "OFL-lexend.txt",
        "OFL-manrope.txt",
        "OFL-nunitosans.txt",
        "OFL-plusjakartasans.txt",
        "OFL-publicsans.txt",
        "OFL-sourcesans3.txt",
        "OFL-rubikbubbles.txt",
        "OFL-bowlbyone.txt",
        "OFL-bungeeinline.txt",
    ],
}

prebuilt_font {
    name: "IchthysSyne-VF.ttf",
    src: "Syne-VF.ttf",
    filename: "Syne-VF.ttf",
    product_specific: true,
}

prebuilt_font {
    name: "IchthysInstrumentSans-VF.ttf",
    src: "InstrumentSans-VF.ttf",
    filename: "InstrumentSans-VF.ttf",
    product_specific: true,
}

prebuilt_font {
    name: "IchthysJetBrainsMono-VF.ttf",
    src: "JetBrainsMono-VF.ttf",
    filename: "JetBrainsMono-VF.ttf",
    product_specific: true,
}

prebuilt_font {
    name: "IchthysOutfit-VF.ttf",
    src: "Outfit-VF.ttf",
    filename: "Outfit-VF.ttf",
    product_specific: true,
}

prebuilt_font {
    name: "IchthysIBMPlexSans-VF.ttf",
    src: "IBMPlexSans-VF.ttf",
    filename: "IBMPlexSans-VF.ttf",
    product_specific: true,
}

// System font options (body faces; each has a Font<Name>Overlay).

prebuilt_font {
    name: "IchthysAtkinsonHyperlegibleNext-VF.ttf",
    src: "AtkinsonHyperlegibleNext-VF.ttf",
    filename: "AtkinsonHyperlegibleNext-VF.ttf",
    product_specific: true,
}

