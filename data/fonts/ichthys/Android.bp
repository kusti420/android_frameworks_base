// Lock screen clock display faces (SettingsLib DepthClockView FONT_BUBBLE / FONT_BLOCK /
// FONT_INLINE; read from /product/fonts by path, like IchthysDepth's faces from /system/fonts).

prebuilt_font {
    name: "IchthysRubikBubbles-Regular.ttf",
    src: "RubikBubbles-Regular.ttf",
    filename: "RubikBubbles-Regular.ttf",
    product_specific: true,
}

